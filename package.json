{
  "name": "bootstrap5-fullsite-eleventy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:css && eleventy --serve",
    "build:css": "sass src/assets/scss/main.scss src/assets/css/main.css --no-source-map --style=compressed",
    "build": "npm run build:css && eleventy",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bootstrap": "^5.3.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "sass": "^1.80.0"
  }
}

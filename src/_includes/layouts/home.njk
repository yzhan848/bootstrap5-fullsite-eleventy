{% extends "layouts/base.njk" %}

{% block content %}
<section class="hero">
  <div class="container hero__inner">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="hero__title">專業 RWD 網站切版示範</h1>
        <p class="hero__subtitle">
          使用 Bootstrap 5、SCSS 變數與 BEM 命名完成的多頁式企業形象網站。
        </p>
        <div class="hero__actions">
          <a href="/services/" class="btn btn-primary hero__btn hero__btn--primary">查看服務項目</a>
          <a href="/about/" class="btn btn-outline-primary hero__btn hero__btn--secondary">了解更多</a>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="hero__card">
          <h2 class="hero__card-title">專案技術重點</h2>
          <ul class="hero__list">
            <li class="hero__list-item">Bootstrap 5 + 自訂 SCSS 變數</li>
            <li class="hero__list-item">BEM 命名規範</li>
            <li class="hero__list-item">Eleventy SSG 產生靜態 HTML</li>
            <li class="hero__list-item">Node 20 / Yarn 可直接執行</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="features">
  <div class="container">
    <div class="section-heading">
      <h2 class="section-heading__title">為何選擇 NovaStudio？</h2>
      <p class="section-heading__subtitle">
        從設計到前端實作，一次到位的全站切版服務。
      </p>
    </div>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="feature-card">
          <h3 class="feature-card__title">RWD 響應式設計</h3>
          <p class="feature-card__text">
            採用 Bootstrap Grid 系統，針對桌機、平板與手機分別優化版面。
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card">
          <h3 class="feature-card__title">可維護的 SCSS 架構</h3>
          <p class="feature-card__text">
            以變數與 partials 管理色彩、字體與間距，方便後續擴充與改版。
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card">
          <h3 class="feature-card__title">SEO 友善結構</h3>
          <p class="feature-card__text">
            依照語意化 HTML5 標籤與結構設計，有利搜尋引擎收錄。
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
